{
  "name": "@local/dsh-skill-picker",
  "version": "1.1.0",
  "private": true,
  "description": "Skill picker and in-app installer for the DeepSeek Harness composer: browse skills by lifecycle phase, search in Chinese or English, insert them as /name, and install new ones from a repo, URL, pasted SKILL.md, or the skills.sh registry.",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": {
    "name": "Sakura025",
    "url": "https://github.com/Sakura025"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "skill-picker",
    "skill-installer",
    "composer",
    "deepseek"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sakura025/dsh-skill-picker.git"
  },
  "homepage": "https://github.com/Sakura025/dsh-skill-picker#readme",
  "bugs": {
    "url": "https://github.com/Sakura025/dsh-skill-picker/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "verify": "node verify.mjs",
    "verify:host": "node verify-host.mjs",
    "verify:skills": "node verify-skills.mjs",
    "verify:provider": "node verify-provider.mjs",
    "verify:roundtrip": "node verify-roundtrip.mjs",
    "regression": "node regression.mjs",
    "audit": "node audit.mjs",
    "check": "node --check client.js && node --check index.js && node audit.mjs && node verify.mjs && node verify-host.mjs && node verify-skills.mjs && node verify-provider.mjs && node verify-roundtrip.mjs && node regression.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
